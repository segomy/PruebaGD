@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>Ventas GD</h1>

    
<form asp-action="Index" method="get">
    <label class="control-label">Lista Categorias</label>
    <select name="CodigoCategoriaParm" asp-items="@ViewBag.ListCategoria" class="form-control" onchange="this.form.submit()">
    <option value="">-- Seleccione Categoria --</option>
    </select>
</form>
  

<div class="card">
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th>
                        Producto
                    </th>
                    <th>
                        Fecha
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ViewBag.Ventas)
                {
                    <tr>
                        <td>
                            @item.Nombre
                        </td>
                        <td>
                            @item.Fecha
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>